# LLM Provider (openai | bedrock)
LLM_PROVIDER=openai
OPENAI_API_KEY=your-openai-key-here

# Model routing (stage -> model id)
MODEL_PLAN=gpt-4o-mini
MODEL_DRAFT=gpt-4o
MODEL_REVIEWER=gpt-4o-mini
MODEL_REWRITE=gpt-4o
MODEL_STYLE=gpt-4o-mini
MODEL_FINAL=gpt-4o
MODEL_QUIZ=gpt-4o-mini
MODEL_IMAGE=gpt-image-1

# Reviewer diversity (optional alternate provider per reviewer)
DIVERSITY_PROVIDER=false
MODEL_REVIEWER_TECHNICAL_ALT=
MODEL_REVIEWER_STYLE_ALT=
MODEL_REVIEWER_STRUCTURE_ALT=
MODEL_REVIEWER_GROUNDING_ALT=

# Image generation
IMAGE_COUNT=4
IMAGE_COUNT_MAX=5
IMAGE_ASPECT_RATIO=16:9
IMAGE_QUALITY=hd

# Pipeline limits
MAX_REVIEW_ITERATIONS=12
MAX_STYLE_PASS=2
MAX_GROUNDING_RECHECK=2
MAX_IMAGE_REDRAW=2
MAX_EDITOR_RETRIES=2
EDITOR_SCORE_THRESHOLD=8.0

# Style guide
MEDIUM_STYLE_GUIDE_PATH=skills/medium.md
MEDIUM_STYLE_GUIDE_REQUIRED=true

# Persistence
DATABASE_URL=sqlite:///./data/medium_agent.db
CHECKPOINT_DB_PATH=./data/checkpoints.db

# Observability
TRACING_ENABLED=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=medium-article-agent

# AWS Bedrock (Phase 8)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
BEDROCK_MODEL_PLAN=
BEDROCK_MODEL_DRAFT=

# Server
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
